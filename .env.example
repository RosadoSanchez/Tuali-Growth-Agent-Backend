# Copia este archivo como .env y llena los valores.
# cp .env.example .env

# --- Base de datos (obligatorio) ---
# Cadena de conexión de MongoDB Atlas.
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/tuali

# Puerto del servidor (opcional, default 3000)
PORT=3000

# --- Gemini (opcional pero recomendado) ---
# API key de Google AI Studio: https://aistudio.google.com/apikey
# Si la dejas vacía, el chat de Capi usa el fallback con datos reales.
GEMINI_API_KEY=

# Modelo de Gemini a usar (default gemini-2.0-flash).
GEMINI_MODEL=gemini-2.5-flash
